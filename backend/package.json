{
  "name": "skill-atlas-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Express API backed by CognoDB (openCypher/Bolt) for the Skill Atlas graph app",
  "main": "src/server.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "seed": "node src/seed.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "neo4j-driver": "^5.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
