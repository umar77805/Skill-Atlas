{
  "name": "skill-atlas-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Express API backed by CognoDB (openCypher/Bolt) for the Skill Atlas graph app",
  "main": "src/server.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "seed": "node src/seed.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "neo4j-driver": "^6.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "typescript": "~7.0.2"
  }
}
