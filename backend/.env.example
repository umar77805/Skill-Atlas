# Copy this file to .env and fill in the values from your CognoDB Cloud instance
# (console.cognodb.com -> your instance -> Connection details)

COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your-generated-password>

PORT=4000
# Comma-separated list of origins allowed to call this API (your deployed frontend URL)
CORS_ORIGIN=http://localhost:5173
